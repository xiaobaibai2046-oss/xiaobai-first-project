FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 zlib1g ca-certificates && rm -rf /var/lib/apt/lists/*
COPY requirements-tdx.txt /app/
RUN pip install --no-cache-dir -r requirements-tdx.txt && useradd --create-home --uid 10001 collector && chown -R collector /usr/local/lib/python3.12/site-packages/tdxaidata/lib
COPY --chown=collector:collector . /app/
USER collector
EXPOSE 8010
CMD ["python", "server.py", "--host", "0.0.0.0", "--port", "8010"]
